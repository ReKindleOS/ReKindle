# Copy this file to /mnt/us/rekindle-fullscreen.conf to customise the
# ReKindle Fullscreen launcher. Keep the quotes.

# Page opened by the launcher. Keep the normal ReKindle layout.
URL="https://rekindle.ink/"

# Chromium device scale factor. 2 is the default on 1072px-wide screens and
# 1 is used on 600px-wide screens. Try 1.5 if text is too large or too small.
# DSF="2"

# Chromium host window position. The stock browser uses 0,215. If the page is
# offset or leaves a blank strip, try "0,0" here.
# CORD="0,215"
