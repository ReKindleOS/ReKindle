/sw.js
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/locales/*
  Cache-Control: public, max-age=3600

/openmoji/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/ReKindle-Fullscreen.zip
  Content-Disposition: attachment
  Cache-Control: no-cache

/downloads/SHA256SUMS.txt
  Content-Disposition: attachment
  Cache-Control: no-cache

# Kindle-friendly direct downloads. Amazon's stock browser filters .sh URLs,
# so the .txt alias serves the same bytes with a filename ending in .sh.
/downloads/ReKindle.sh
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/downloads/ReKindle.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/downloads/ReKindleStop.sh
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindleStop.sh"
  Cache-Control: no-cache

/downloads/ReKindleStop.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindleStop.sh"
  Cache-Control: no-cache

/kindle.sh
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/kindle.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
