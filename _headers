# Versioned assets (every page links them with ?v=N, bumped whenever the bytes
# change — enforced by scripts/test-load-budget.js). The URL identifies the
# content, so revalidation is pure latency on a slow Kindle link. HTML is
# deliberately NOT in this group: it must stay revalidate-always.
#
# Order matters: this broad rule comes first, and every later block that needs a
# different Cache-Control on a matching path detaches it with `! Cache-Control`
# before setting its own (Cloudflare Pages merges matching rules otherwise).
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# mario_assets/*.js are the only local scripts with no ?v=, so they keep the
# short cache.
/mario_assets/*
  ! Cache-Control
  Cache-Control: public, max-age=14400

/locales/*
  Cache-Control: public, max-age=3600

/openmoji/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/ReKindle-Fullscreen.zip
  Content-Disposition: attachment
  Cache-Control: no-cache

/downloads/SHA256SUMS.txt
  Content-Disposition: attachment
  Cache-Control: no-cache

# KPM repository/package files are fetched by curl on the device.
/downloads/kpm/*
  ! Cache-Control
  Cache-Control: no-cache

# Direct downloads are for patched browsers only; stock firmware rejects
# .sh/.txt as "Invalid file type". Keep the aliases for those users.
/downloads/ReKindle.sh
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/downloads/ReKindle.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/kindle.sh
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/kindle.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
