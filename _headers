/sw.js
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/locales/*
  Cache-Control: public, max-age=3600

/openmoji/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/ReKindle-Fullscreen.zip
  Content-Disposition: attachment
  Cache-Control: no-cache

/downloads/SHA256SUMS.txt
  Content-Disposition: attachment
  Cache-Control: no-cache

# KPM repository/package files are fetched by curl on the device.
/downloads/kpm/*
  Cache-Control: no-cache

# Direct downloads are for patched browsers only; stock firmware rejects
# .sh/.txt as "Invalid file type". Keep the aliases for those users.
/downloads/ReKindle.sh
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/downloads/ReKindle.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/kindle.sh
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/kindle.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="ReKindle.sh"
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
